{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eleventy",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["@11ty/eleventy", "--serve", "--port=8099"],
      "port": 8099
    },
    {
      "name": "web-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8101", "--directory", "web"],
      "port": 8101
    },
    {
      "name": "color-tokens",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8100", "--directory", "static/color-tokens"],
      "port": 8100
    }
  ]
}
